{
  "permissions": {
    "allow": [
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:rev-parse*)",
      "Shell(git:merge-base*)",
      "Shell(git:rev-list*)",
      "Shell(git:branch*)",
      "Shell(git:stash list*)",
      "Shell(ls)",
      "Shell(ls:*)",
      "Shell(cat)",
      "Shell(cat:*)",
      "Shell(head)",
      "Shell(head:*)",
      "Shell(tail)",
      "Shell(tail:*)",
      "Shell(test)",
      "Shell(test:*)",
      "Shell(grep)",
      "Shell(grep:*)",
      "Shell(rg)",
      "Shell(rg:*)"
    ],
    "deny": [
      "Shell(brew:install*)",
      "Shell(brew:upgrade*)",
      "Shell(pip)",
      "Shell(pip:*)",
      "Shell(pip3)",
      "Shell(pip3:*)",
      "Shell(npm:install*)",
      "Shell(npm:add*)",
      "Shell(yarn:install*)",
      "Shell(yarn:add*)",
      "Shell(pnpm:install*)",
      "Shell(pnpm:add*)",
      "Shell(curl)",
      "Shell(curl:*)",
      "Shell(wget)",
      "Shell(wget:*)",
      "Shell(rm)",
      "Shell(rm:*)",
      "Shell(sudo)",
      "Shell(sudo:*)",
      "Shell(chmod)",
      "Shell(chmod:*)",
      "Shell(git:clean*)",
      "Shell(git:reset --hard*)",
      "Shell(git:reset*--hard*)",
      "Shell(git:push --force*)",
      "Shell(git:push*--force*)",
      "Shell(git:push -f*)",
      "Shell(git:push*-f *)",
      "Shell(git:push* -f)"
    ]
  }
}
