#!/usr/bin/env python3
"""One-command launcher for the Looming Dark control-plane CLI."""

from pathlib import Path
import runpy
import sys

ROOT = Path(__file__).resolve().parent.parent
cli = ROOT / "control-plane" / "ldi.py"
if not cli.is_file():
    sys.stderr.write(f"error: control-plane CLI not found at {cli}\n")
    sys.exit(2)
sys.argv[0] = str(cli)
runpy.run_path(str(cli), run_name="__main__")
